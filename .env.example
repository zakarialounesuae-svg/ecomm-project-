# Port d'écoute du serveur
PORT=3000

# Identifiant de la Google Sheet cible (visible dans l'URL de la feuille)
GOOGLE_SHEET_ID=

# Nom de l'onglet où ajouter les lignes (doit contenir les en-têtes de la section 8 du PRD)
GOOGLE_SHEET_TAB=Candidatures

# Compte de service Google (accès limité à cette seule feuille, partagée en "Éditeur" avec cet e-mail)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clé privée du compte de service (bloc PEM complet, avec les \n littéraux conservés entre guillemets)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Fenêtre et plafond anti-spam pour /api/candidature (voir FR-10)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

# Domaine du script des widgets Misdakia (staging par défaut - remplacer avant le lancement public, voir §6.2)
MISDAKIA_WIDGET_ORIGIN=https://misdakia-staging.t4startups.com
